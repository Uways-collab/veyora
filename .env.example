# ==============================================================================
# Veyora Business — Environment Variable Template
# ==============================================================================
# Copy this file to `.env.local` for local development.
# Never commit `.env.local` or real credentials to version control.

# ------------------------------------------------------------------------------
# Supabase Client Configuration (Safe for browser exposure via VITE_ prefix)
# ------------------------------------------------------------------------------
# Found in Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# ------------------------------------------------------------------------------
# Supabase Server-Only Credentials (NEVER prefix with VITE_ or expose in UI)
# ------------------------------------------------------------------------------
# Only used by trusted server-side jobs, edge functions, or Node.js workers.
SUPABASE_SERVICE_ROLE_KEY=""

# ------------------------------------------------------------------------------
# Optional Platform Runtime Variables
# ------------------------------------------------------------------------------
APP_URL="MY_APP_URL"
GEMINI_API_KEY="MY_GEMINI_API_KEY"
